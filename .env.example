# Companies House API key. Get one at
# https://developer.company-information.service.gov.uk/manage-applications
COMPANIES_HOUSE_API_KEY=your_key_here

# Date range of incorporation. Either give both dates (YYYY-MM-DD)...
# INCORPORATED_FROM=2026-09-01
# INCORPORATED_TO=2026-09-19
# ...or just how many days back from today (used when the dates are not set).
DAYS_BACK=7

# Stop after this many new companies in one run.
MAX_RESULTS=1000

# Gemini API Key for AI email generation (Phase 3)
GEMINI_API_KEY=your_gemini_api_key_here

# Outreach Sender & Signature Details (Optional overrides)
# SENDER_NAME=Nahid
# SENDER_WHATSAPP=+880 1615-753465
# SPAM_ALERT_EMAIL=you@example.com

# SMTP relay credentials for email delivery. The sender is fixed in code to
# partners@mail.usasocialhubofficial.com and replies go to
# partners@usasocialhubofficial.com; do not override either address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
# Set SMTP_MOCK=true for dry runs / offline testing
# SMTP_MOCK=true
