# Companies House API key. Get one at
# https://developer.company-information.service.gov.uk/manage-applications
COMPANIES_HOUSE_API_KEY=your_key_here

# Date range of incorporation. Either give both dates (YYYY-MM-DD)...
# INCORPORATED_FROM=2026-04-01
# INCORPORATED_TO=2026-07-01
# ...or target window in days back (3 to 6 months sweet spot: 90 to 180 days):
DAYS_BACK_MIN=90
DAYS_BACK_MAX=180
# DAYS_BACK=7

# Stop after this many new companies in one run.
MAX_RESULTS=1000

# Gemini API Key for AI email generation (Phase 3)
GEMINI_API_KEY=your_gemini_api_key_here

# Outreach Sender & Signature Details (Optional overrides)
# SENDER_NAME=Nahid
# SENDER_WHATSAPP=+880 1615-753465

# Alert notification recipients
# SPAM_ALERT_EMAIL: Destination address for security alerts triggered when generated email content matches spam keyword patterns
# SPAM_ALERT_EMAIL=you@example.com
# QUOTA_ALERT_EMAIL: Destination address for immediate alerts when email verification API provider quotas or rate limits are exhausted
# QUOTA_ALERT_EMAIL=jr6259094@gmail.com

# SMTP relay credentials for email delivery.
# You must provide the EMAIL_FROM address, e.g. "Nahid <nahid@example.com>"
EMAIL_FROM=your_sender_address@example.com

# Mode 1: Single SMTP relay (e.g. Gmail / Resend / Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password

# Mode 2: Multi-Account Rotation & Quota Failover with multiple Resend keys
# Provide comma-separated API keys in SMTP_PASS sharing host, user, and port:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_key1_abc123,re_key2_def456,re_key3_ghi789

# Mode 3: Multi-Provider Failover Pool (e.g. Resend primary + Brevo fallback)
# Provide comma-separated host, user, pass (and optionally port):
# SMTP_HOST=smtp.resend.com,smtp-relay.brevo.com
# SMTP_PORT=587,587
# SMTP_USER=resend,your_brevo_account@smtp-brevo.com
# SMTP_PASS=re_key1_abc123,xsmtpsib_key2_xyz789

# Mode 4: Explicit JSON Array configuration
# SMTP_CONFIGS=[{"host":"smtp.resend.com","port":587,"user":"resend","pass":"re_123"},{"host":"smtp-relay.brevo.com","port":587,"user":"brevo_user","pass":"xsmtp_456"}]

# Set SMTP_MOCK=true for dry runs / offline testing
# SMTP_MOCK=true

# Enable HTML formatting and Resend 1x1 open tracking pixel injection (default: true)
ENABLE_HTML_EMAIL=true

# Follow-up Outreach Credentials (Account 2)
# FOLLOWUP_EMAIL_FROM="Nahid <nahid@mail.usasocialhubofficial.com>"
# FOLLOWUP_RESEND_API_KEY=your_followup_resend_api_key_here


